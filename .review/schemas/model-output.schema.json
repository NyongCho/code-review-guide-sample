{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "model-output",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "verified",
        "findings",
        "needs_human",
        "incomplete",
        "failed"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "bug",
              "security",
              "spec"
            ]
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "path": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "kind",
          "severity",
          "path",
          "condition",
          "impact",
          "evidence",
          "line"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "patch": {
      "type": "string"
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "confirmed",
              "dismissed",
              "resolved",
              "pending"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "decision",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "findings",
    "summary",
    "risk",
    "patch",
    "dispositions"
  ],
  "additionalProperties": false
}
