{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "self_hosted",
        "api"
      ]
    },
    "repository": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "effort": {
      "type": "string"
    },
    "codex_version": {
      "type": "string"
    },
    "test_commands": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "api_budget": {
      "type": "object",
      "properties": {
        "approved_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_calls": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "approved_usd",
        "max_calls"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "mode",
    "repository",
    "model",
    "effort",
    "codex_version",
    "test_commands"
  ],
  "additionalProperties": true
}
